# ============ COPIA ESTE ARCHIVO COMO .env Y LLÉNALO ============

# --- IA: consigue tu clave gratis en https://aistudio.google.com/apikey ---
GEMINI_API_KEY=
GEMINI_MODELO=gemini-3.5-flash-lite

# --- Quién eres (el agente responde en tu nombre) ---
TU_NOMBRE=Tu Nombre
CONTEXTO_PERSONAL=Trabajo como ... en la empresa ... Respondo de forma cordial y profesional. Moneda: MXN.

# --- Calidad ---
# Si la IA entiende la tarea con menos de este % y faltan datos, en vez de inventar te prepara una pregunta.
CONFIANZA_MINIMA=70
MAX_REINTENTOS=2

# --- CORREO (Gmail: activa verificación en 2 pasos y crea una "Contraseña de aplicación") ---
CORREO_ACTIVO=false
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
# Outlook/Hotmail: IMAP_HOST=outlook.office365.com  SMTP_HOST=smtp.office365.com  SMTP_PORT=587
CORREO_USUARIO=tu_correo@gmail.com
CORREO_PASSWORD=contraseña_de_aplicacion
# Vacío = todos. Ejemplo: jefe@empresa.com,@cliente.com
CORREO_REMITENTES_PERMITIDOS=
CORREO_IGNORAR_BOLETINES=true

# --- TELEGRAM (crea un bot con @BotFather) ---
TELEGRAM_ACTIVO=false
TELEGRAM_BOT_TOKEN=
# Tu chat_id: escribe /start a tu bot y te lo dirá. Aquí te llegan los avisos con botones Aprobar/Rechazar.
TELEGRAM_CHAT_DUENO=
# Vacío = cualquiera que le escriba al bot. Ejemplo: 123456789,usuario_telegram
TELEGRAM_CHATS_PERMITIDOS=

# --- VOZ ---
# El agente te contesta con nota de voz en Telegram cuando tú le hablas
VOZ_RESPUESTAS=true
# Acento de la voz: com.mx (México), es (España), com.ar (Argentina), us (Latino neutro)
VOZ_ACENTO=com.mx
# Idioma del micrófono en el panel web (Chrome/Edge)
VOZ_IDIOMA_PANEL=es-MX

# --- WHATSAPP (WhatsApp Business Cloud API: https://developers.facebook.com) ---
WHATSAPP_ACTIVO=false
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_VERIFY_TOKEN=mi_token_secreto
# Números con lada sin +. Ejemplo: 5215512345678
WHATSAPP_NUMEROS_PERMITIDOS=

# --- Panel ---
INTERVALO_SEGUNDOS=60
PANEL_PUERTO=5000
PANEL_URL=http://127.0.0.1:5000
PANEL_USUARIO=admin
# Pon una clave si vas a exponer el panel con ngrok (obligatorio por seguridad en ese caso)
PANEL_CLAVE=

# --- Base de datos permanente en nube (PostgreSQL de Render/Supabase/Neon) ---
DATABASE_URL=

# --- Briefing diario y zona horaria ---
ZONA_HORARIA_OFFSET=-5
BRIEFING_ACTIVO=true
BRIEFING_HORA=08:00
BRIEFING_CIUDAD=
